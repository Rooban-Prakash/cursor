{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.filemanager.widget",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "/**" },
        { "path": "**" }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "/**" },
        { "path": "**" }
      ]
    }
  ]
}
